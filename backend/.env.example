# Optional override. If empty, backend builds URL from MYSQL_* variables.
DATABASE_URL=
UPLOAD_ROOT=../uploads
SETTINGS_PATH=data_sources.json
WIDGET_LAYOUT_PATH=dashboard_widgets.json
JWT_SECRET_KEY=change_me_before_production
