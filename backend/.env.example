APP_NAME="CJ WMS Dashboard API"
APP_ENV=development
USE_MOCK=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cj_wms_dashboard
MYSQL_USER=cj_wms_user
