APP_NAME="CJ WMS Dashboard API"
APP_ENV=development
USE_MOCK=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cj_wms_dashboard
MYSQL_USER=cj_wms_user
MYSQL_PASSWORD=change_me
# Optional override. If empty, backend builds URL from MYSQL_* variables.
DATABASE_URL=
UPLOAD_ROOT=../uploads
SETTINGS_PATH=data_sources.json
WIDGET_LAYOUT_PATH=dashboard_widgets.json
JWT_SECRET_KEY=change_me_before_production

# Automatic Excel source. The Windows account running Backend must have read access.
FILE_SERVER_SYNC_ENABLED=false
FILE_SERVER_PATH=\\10.84.194.51\CJWMSDashboard
FILE_SERVER_SYNC_SECONDS=1800
APP_TIMEZONE=Asia/Bangkok
FILE_SERVER_MAX_FILE_MB=25
FILE_SERVER_MIRROR_URL=
FILE_SERVER_MIRROR_TOKEN=
